# Backend environment variables — copy to backend/.env and fill in real values
# NEVER commit the actual .env file.

# ─── Database ───────────────────────────────────────────────────────────────
# SQLite (default, absolute path resolved automatically by config.py)
# DATABASE_URL=sqlite:////absolute/path/to/fireflies.db
# Postgres example for production:
# DATABASE_URL=postgresql://user:password@host:5432/lumen_db

# ─── AI / LLM ───────────────────────────────────────────────────────────────
# Get your key at https://console.groq.com
GROQ_API_KEY=

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In production set this to your deployed Vercel/Netlify URL.
# Example: CORS_ORIGINS=https://lumen.vercel.app,https://www.lumen.app
CORS_ORIGINS=http://localhost:3000

# ─── Server ─────────────────────────────────────────────────────────────────
# Most hosting platforms (Render, Railway) inject PORT automatically.
PORT=8000
