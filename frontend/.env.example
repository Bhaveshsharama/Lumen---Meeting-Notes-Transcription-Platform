# Frontend environment variables — copy to frontend/.env.local and fill in values.
# NEVER commit the actual .env.local file.

# ─── Backend API URL ─────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL: used directly in browser-side fetch calls (PDF export etc.)
# Example: NEXT_PUBLIC_API_URL=https://lumen-api.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# BACKEND_URL: used in next.config.ts server-side proxy rewrites (no /api suffix)
# Example: BACKEND_URL=https://lumen-api.onrender.com
BACKEND_URL=http://localhost:8000
